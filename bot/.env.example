# Token from @BotFather. Required.
BOT_TOKEN=

# Public URL of the quiz, used when someone opens the bot without a setup code.
WEB_URL=https://your-project.vercel.app

# SQLite file. On Railway, mount a volume at /data and use /data/cryptopulse.db.
DB_PATH=./data/cryptopulse.db

# Time zone for summaries and quiet hours (23:00â€“08:00).
TIME_ZONE=Europe/Kyiv

# How often to check prices, in seconds (minimum 15).
CHECK_INTERVAL_SEC=60

# Binance market-data host. The default works in more regions than api.binance.com.
BINANCE_API_BASE=https://data-api.binance.vision

# Optional: your own Telegram chat id, to use /stats. Send /id to the bot to see it.
ADMIN_CHAT_ID=
