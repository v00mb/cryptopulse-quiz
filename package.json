{
  "name": "cryptopulse",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "bot"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:bot": "npm run dev -w bot",
    "build": "npm run build -w web && npm run build -w bot",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test \"shared/src/**/*.test.ts\" \"web/src/**/*.test.ts\" \"bot/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
